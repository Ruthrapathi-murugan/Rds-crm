# ─────────────────────────────────────────────────────────────
# RDS CRM — environment variables
# Copy to .env.local for local development:  cp .env.example .env.local
# Never commit .env.local or real credentials.
# On Vercel, set these under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas connection string (include the database name, e.g. /rds_crm)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rds_crm?retryWrites=true&w=majority

# Secret used to sign session data. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Public base URL of the app (no trailing slash). Used in emails and links.
APP_URL=http://localhost:3000

# SMTP settings for email notifications (invoices, reminders).
# Leave SMTP_HOST empty to disable outgoing email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Ruthra Digital Solutions <no-reply@example.com>"

# Secret for the reminder scheduler (GET /api/cron/reminders). At least 16 characters.
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
# External schedulers must send the same header. Leave empty to disable the cron endpoint.
CRON_SECRET=
